{
  "name": "blake-gate",
  "version": "0.4.0",
  "description": "Policy enforcement runtime for autonomous agents — intent fingerprints, proof-carrying allow, hire isolation, spawn/replicate gates, post-action compliance. Part of blake-guard.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "blake-gate": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "INTEGRATING.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndblk3/blake-gate.git"
  },
  "bugs": {
    "url": "https://github.com/ndblk3/blake-gate/issues"
  },
  "homepage": "https://bl4k3.com/gate",
  "keywords": [
    "agents",
    "policy",
    "guardrails",
    "autonomous",
    "blake",
    "blake-guard",
    "intent-gate",
    "replication"
  ],
  "author": "Blake / bl4k3.com",
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
